{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockAgent",
  "version": "0.1.0",
  "identifier": "com.stockagent.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stock Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      },
      {
        "label": "pet",
        "title": "Stock Agent",
        "width": 132,
        "height": 108,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "create": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.stockagent/pets/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
