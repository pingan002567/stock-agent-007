{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-backend",
  "description": "开发态 Vite（localhost:5173）需要 remote IPC：桌面 SPA 自托管，不再加载后端 HTML。",
  "remote": {
    "urls": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "windows": [
    "main"
  ],
    "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "allow-service-cli",
    "allow-navigate",
    "allow-open-external"
  ]
}
