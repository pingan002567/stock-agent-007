  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "allow-service-cli",
    "allow-navigate"
  ]
