# AI 模型配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
WORKBENCH_AI_MODEL=deepseek-chat

# 可选：其他 AI 提供商
# ANTHROPIC_API_KEY=your_claude_key
# GEMINI_API_KEY=your_gemini_key

# 联网搜索（web_search 工具）。默认用 DuckDuckGo（无需 key）。
# 配置任一 key 即自动升级：Tavily 优先，其次 Serper(Google)。
# TAVILY_API_KEY=tvly-xxx     # https://tavily.com （并启用 web_fetch）
# SERPER_API_KEY=xxx          # https://serper.dev

# AI 子代理并行（多技能 intent 默认开）。off=全关，all=全部 intent 开
# WORKBENCH_AI_SUBAGENT=off

# 计划模式（write_todos 计划清单+未完成不收口；调仓/审查/回测 intent 默认开）
# WORKBENCH_AI_PLAN_MODE=off   # off=全关，all=全部 intent 开

# 多模态看图（view_image 工具，K线截图/研报图表分析）。
# 默认按模型名自动判定（gpt-4o/claude/gemini/qwen-vl 等命中即开），可显式覆盖：
# WORKBENCH_AI_VISION=1

# 可观测 Tracing（排查 agent 执行链 / token 成本分析）。
# DeerFlow 原生支持，纯环境变量驱动，设置后重启即生效：
# LANGFUSE_TRACING=1
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # 或自托管地址
# 也支持 LangSmith：LANGSMITH_TRACING=1 + LANGSMITH_API_KEY=xxx